# Copy to server/.env and fill in to enable real AI generation.
# Without a key, the server falls back to a deterministic stub generator.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Firestore (optional) ---
# Set these to use Firestore instead of the JSON file. Get a service account key
# from Firebase Console → Project Settings → Service Accounts → Generate key.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# For local testing with the emulator instead of real Firestore:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# session token secret (any long random string)
AUTH_SECRET=

# --- Google Places (optional) — powers venue PHOTOS + REVIEWS + hours/ratings ---
# This is the ONLY map-related key, and it is for place CONTENT, not the basemap
# (the map itself is keyless: MapLibre + Protomaps/OSM). Without it, place
# enrichment runs a stub. Get a key at Google Cloud Console → APIs & Services →
# Credentials, ENABLE "Places API (New)", and RESTRICT the key to that API + your
# server's IP. Never expose this key to the app. See docs/maps-setup.md.
GOOGLE_MAPS_API_KEY=
